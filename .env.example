# ====================================================
# TTC FLEET360 - Environment Variables Configuration
# ====================================================

# Database (PostgreSQL)
POSTGRES_DB=ttc_fleet360
POSTGRES_USER=fleetadmin
POSTGRES_PASSWORD=Fleet360SecurePass!
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ttc_fleet360
SPRING_DATASOURCE_USERNAME=fleetadmin
SPRING_DATASOURCE_PASSWORD=Fleet360SecurePass!

# Caching (Redis)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET=9a3f8c7e2b1d6f5a4e3c2b1a0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e
JWT_EXPIRATION=86400000

# AWS S3 Cloud Storage
AWS_S3_ENABLED=false
AWS_S3_BUCKET=ttc-fleet360-assets
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# Frontend
VITE_API_URL=http://localhost:8080/api
